    "dataSources": {
        "ds_1YYAkZ6c": {
            "name": "Search_9",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security\n| eval Event_ID=coalesce(EventCode, EventID)\n| eval User=coalesce(Account_Name, TargetUserName, user)\n| eval Source_IP=coalesce(Source_Network_Address, IpAddress)\n| table _time Event_ID User Source_IP\n| sort - _time\n| head 20"
            },
            "type": "ds.search"
        },
        "ds_4Aq9rGhw": {
            "name": "Search_6",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security\n| table _time EventCode Account_Name Source_Network_Address\n| sort - _time\n| head 20"
            },
            "type": "ds.search"
        },
        "ds_5e8j3mrT": {
            "name": "Search_5",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security (EventCode=4624 OR EventCode=4625)\n| timechart span=1h count by EventCode"
            },
            "type": "ds.search"
        },
        "ds_Pbmd1t4l": {
            "name": "Search_1",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| eval SourceIP=coalesce(Source_Network_Address, IpAddress)\n| where isnotnull(SourceIP) AND SourceIP!=\"-\"\n| stats count AS Failed_Attempts by SourceIP\n| sort - Failed_Attempts\n| head 10"
            },
            "type": "ds.search"
        },
        "ds_QbHhNo1a": {
            "name": "4624",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4624\n| stats count AS \"Successful Logins\""
            },
            "type": "ds.search"
        },
        "ds_UFxjD91L": {
            "name": "Search_8",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4624\n| stats count AS \"Total Logons\""
            },
            "type": "ds.search"
        },
        "ds_UtwdXtPM": {
            "name": "Search_7",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| stats count AS \"Failed Logons\""
            },
            "type": "ds.search"
        },
        "ds_cSFySi3g": {
            "name": "Search_4",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| stats count by Account_Name\n| sort - count"
            },
            "type": "ds.search"
        },
        "ds_nZYVoY3E": {
            "name": "Search_2",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| stats count AS \"Failed Attempts\" by Account_Name\n| sort - \"Failed Attempts\""
            },
            "type": "ds.search"
        },
        "ds_p5qWM2e4": {
            "name": "Search_10",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security\n| eval Event_ID=coalesce(EventCode, EventID)\n| eval User=coalesce(Account_Name, TargetUserName, user)\n| eval Source_IP=coalesce(Source_Network_Address, IpAddress)\n| sort - _time\n| head 20\n| eval Time=strftime(_time,\"%m/%d %I:%M:%S %p\")\n| table Time Event_ID User Source_IP"
            },
            "type": "ds.search"
        },
        "ds_u5OW6kgS": {
            "name": "Search_3",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| stats count by Account_Name\n| sort - count"
            },
            "type": "ds.search"
        },
        "ds_ydpuLe0K": {
            "name": "4625",
            "options": {
                "query": "index=* sourcetype=WinEventLog:Security EventCode=4625\n| stats count AS \"Failed Login Attempts\"",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            },
            "type": "ds.search"
        }
    },
